{
  "name": "uk-tenders-mcp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UK Tenders MCP — remote MCP API (TypeScript) over BigQuery",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
